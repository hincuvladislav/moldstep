---
import { nav, site } from "@lib/site";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="sticky top-0 z-50 border-b border-edge bg-night/85 backdrop-blur-md">
  <div class="container-site flex h-[68px] items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 text-[17px] font-semibold tracking-[-0.01em]">
      <span class="grid size-7 place-items-center rounded-md bg-white font-mono text-xs font-bold text-night">M</span>
      {site.name}
    </a>

    <nav class="hidden items-center gap-8 text-sm md:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "transition-colors duration-150 hover:text-white",
              currentPath === item.href ? "font-medium text-white" : "text-dusk-2",
            ]}
            aria-current={currentPath === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/contact"
        class="rounded-lg bg-white px-[18px] py-[9px] text-[13px] font-medium text-night transition-colors duration-150 hover:bg-[#d7d9de]"
      >
        Start a project
      </a>
    </nav>

    <button
      id="menu-toggle"
      class="grid size-10 place-items-center rounded-lg text-white hover:bg-night-card md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M3 5h14M3 10h14M3 15h14" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-edge bg-night md:hidden" aria-label="Mobile">
    <div class="container-site flex flex-col gap-1 py-4">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded-lg px-3 py-2 text-sm hover:bg-night-card",
              currentPath === item.href ? "font-medium text-white" : "text-dusk-2",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/contact" class="btn-light mt-2">Start a project</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
