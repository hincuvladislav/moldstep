---
import { nav, site } from "@lib/site";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="sticky top-0 z-50 border-b border-line bg-white/90 backdrop-blur">
  <div class="container-site flex h-16 items-center justify-between">
    <a href="/" class="flex items-center gap-2 text-lg font-semibold tracking-tight">
      <span class="grid size-7 place-items-center rounded-md bg-ink font-mono text-xs font-bold text-white">M</span>
      {site.name}
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "text-sm transition-colors hover:text-ink",
              currentPath === item.href ? "font-medium text-ink" : "text-muted",
            ]}
            aria-current={currentPath === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/contact" class="btn-primary !px-4 !py-2">Start a project</a>
    </nav>

    <button
      id="menu-toggle"
      class="grid size-10 place-items-center rounded-lg text-ink hover:bg-surface md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M3 5h14M3 10h14M3 15h14" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-line bg-white md:hidden" aria-label="Mobile">
    <div class="container-site flex flex-col gap-1 py-4">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded-lg px-3 py-2 text-sm hover:bg-surface",
              currentPath === item.href ? "font-medium text-ink" : "text-muted",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/contact" class="btn-primary mt-2">Start a project</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
