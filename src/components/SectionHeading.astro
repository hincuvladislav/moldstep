---
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
}

const { eyebrow, title, text } = Astro.props;
---

<div class="max-w-2xl space-y-3">
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">{title}</h2>
  {text && <p class="text-lg text-muted">{text}</p>}
</div>
