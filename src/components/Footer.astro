---
import { nav, site } from "@lib/site";

const year = new Date().getFullYear();
---

<div class="flex items-center justify-between border-t border-edge py-6 text-[13px] text-dusk-4">
  <span>© {year} {site.legalName}</span>
  <div class="flex gap-6">
    {
      nav.map((item) => (
        <a href={item.href} class="transition-colors hover:text-white">
          {item.label}
        </a>
      ))
    }
  </div>
</div>
