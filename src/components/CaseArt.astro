---
/** Greyscale SVG illustrations for case-study cards, from the design. */
interface Props {
  kind: "docs" | "calendar" | "roadmap";
}

const { kind } = Astro.props;
---

<svg viewBox="0 0 300 150" width="100%" height="150" role="img" aria-label="Case study illustration">
  {
    kind === "docs" && (
      <>
        <rect x="96" y="38" width="78" height="96" rx="6" fill="#d4d4d8" transform="rotate(-6 135 86)" />
        <rect x="112" y="30" width="80" height="100" rx="6" fill="#ffffff" stroke="#c8c8cd" stroke-width="1.5" />
        <rect x="126" y="48" width="52" height="6" rx="3" fill="#d4d4d8" />
        <rect x="126" y="62" width="40" height="6" rx="3" fill="#e4e4e7" />
        <rect x="126" y="76" width="48" height="6" rx="3" fill="#e4e4e7" />
        <rect x="126" y="90" width="32" height="6" rx="3" fill="#e4e4e7" />
        <circle cx="196" cy="106" r="20" fill="#18181b" />
        <path d="M188 106l6 6 12-12" stroke="#ffffff" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="86" cy="52" r="5" fill="#c8c8cd" />
        <circle cx="214" cy="42" r="4" fill="#d4d4d8" />
      </>
    )
  }
  {
    kind === "calendar" && (
      <>
        <rect x="102" y="28" width="96" height="98" rx="8" fill="#ffffff" stroke="#c8c8cd" stroke-width="1.5" />
        <rect x="102" y="28" width="96" height="26" rx="8" fill="#d4d4d8" />
        <rect x="114" y="64" width="16" height="14" rx="3" fill="#e4e4e7" />
        <rect x="136" y="64" width="16" height="14" rx="3" fill="#e4e4e7" />
        <rect x="158" y="64" width="16" height="14" rx="3" fill="#e4e4e7" />
        <rect x="114" y="86" width="16" height="14" rx="3" fill="#e4e4e7" />
        <rect x="136" y="86" width="16" height="14" rx="3" fill="#18181b" />
        <rect x="158" y="86" width="16" height="14" rx="3" fill="#e4e4e7" />
        <rect x="114" y="108" width="16" height="14" rx="3" fill="#e4e4e7" />
        <circle cx="208" cy="98" r="18" fill="#18181b" />
        <path d="M208 90v8l6 4" stroke="#ffffff" stroke-width="3" fill="none" stroke-linecap="round" />
        <circle cx="88" cy="56" r="5" fill="#c8c8cd" />
      </>
    )
  }
  {
    kind === "roadmap" && (
      <>
        <path d="M70 110 C 110 110, 110 50, 150 50 S 190 110, 230 110" stroke="#c8c8cd" stroke-width="3" fill="none" stroke-dasharray="1 10" stroke-linecap="round" />
        <circle cx="70" cy="110" r="12" fill="#ffffff" stroke="#c8c8cd" stroke-width="2" />
        <circle cx="70" cy="110" r="4" fill="#a1a1aa" />
        <circle cx="150" cy="50" r="12" fill="#ffffff" stroke="#c8c8cd" stroke-width="2" />
        <circle cx="150" cy="50" r="4" fill="#a1a1aa" />
        <circle cx="230" cy="110" r="16" fill="#18181b" />
        <path d="M226 104v12l10-6z" fill="#ffffff" />
        <rect x="132" y="18" width="36" height="14" rx="7" fill="#d4d4d8" />
        <rect x="52" y="126" width="36" height="14" rx="7" fill="#e4e4e7" />
      </>
    )
  }
</svg>
