---
import "@fontsource-variable/space-grotesk";
import "@styles/global.css";
import Header from "@components/Header.astro";
import { site } from "@lib/site";

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} — ${site.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e0f13" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(Astro.url.pathname, site.url)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>

    <script>
      // Mouse-parallax for 3D scenes: a [data-parallax] zone rotates its
      // [data-scene] child around base angles as the cursor moves.
      document.querySelectorAll<HTMLElement>("[data-parallax]").forEach((zone) => {
        const scenes = [...zone.querySelectorAll<HTMLElement>("[data-scene]")];
        if (!scenes.length) return;
        const params = scenes.map((scene) => ({
          scene,
          baseX: parseFloat(scene.dataset.baseX ?? "12"),
          baseY: parseFloat(scene.dataset.baseY ?? "-16"),
          rangeX: parseFloat(scene.dataset.rangeX ?? "14"),
          rangeY: parseFloat(scene.dataset.rangeY ?? "18"),
        }));
        zone.addEventListener("mousemove", (e) => {
          const r = zone.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          params.forEach(({ scene, baseX, baseY, rangeX, rangeY }) => {
            scene.style.transform = `rotateX(${baseX - y * rangeX}deg) rotateY(${baseY + x * rangeY}deg)`;
          });
        });
        zone.addEventListener("mouseleave", () => {
          params.forEach(({ scene, baseX, baseY }) => {
            scene.style.transform = `rotateX(${baseX}deg) rotateY(${baseY}deg)`;
          });
        });
      });

      // Touch devices: hover never fires, so expandable cards toggle on tap.
      if (window.matchMedia("(hover: none)").matches) {
        document.querySelectorAll<HTMLElement>("[data-expand]").forEach((card) => {
          card.setAttribute("aria-expanded", "false");
          card.addEventListener("click", () => {
            const open = card.classList.toggle("is-open");
            card.setAttribute("aria-expanded", String(open));
          });
        });
      }

      // 3D tilt for cards: strength via data-tilt, lift via data-lift.
      document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
        const strength = parseFloat(el.dataset.tilt || "8");
        const lift = parseFloat(el.dataset.lift ?? "-4");
        el.addEventListener("mousemove", (e) => {
          const r = el.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          el.style.transform = `translateY(${lift}px) rotateX(${-y * strength}deg) rotateY(${x * strength}deg)`;
        });
        el.addEventListener("mouseleave", () => {
          el.style.transform = "";
        });
      });
    </script>
  </body>
</html>
