---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <section class="container-site flex flex-col items-start gap-6 py-32">
    <p class="font-mono text-sm text-muted">404</p>
    <h1 class="text-4xl font-semibold tracking-tight">Page not found</h1>
    <p class="max-w-md text-muted">The page you're looking for doesn't exist or has been moved.</p>
    <a href="/" class="btn-primary">Back to homepage</a>
  </section>
</BaseLayout>
