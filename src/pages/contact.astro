---
import BaseLayout from "@layouts/BaseLayout.astro";
import Footer from "@components/Footer.astro";
import { formEndpoint, site } from "@lib/site";

const topics = ["Custom AI app", "Automation", "Web / mobile", "Consulting", "Cloud & data"];
---

<BaseLayout
  title="Contact"
  description="Start a project with Moldstep LLC. Tell us what you're trying to build — we reply within one business day."
>
  <!-- HERO + FORM -->
  <section class="relative overflow-hidden border-b border-[#1b1e25]" data-parallax>
    <div class="hero-grid absolute inset-0"></div>
    <div class="container-site relative flex flex-col gap-12 py-16 md:py-18 lg:flex-row lg:gap-16">
      <div class="min-w-0 lg:min-w-[440px] lg:flex-1">
        <div class="eyebrow flex items-center gap-2.5 text-dusk-3">
          <span class="h-px w-6 bg-[#3d414c]"></span>Contact
        </div>
        <h1 class="mt-6 text-[clamp(38px,4.4vw,56px)] leading-[1.05] font-semibold tracking-[-0.03em]">
          Tell us what you're trying to build.
        </h1>
        <p class="mt-6 max-w-[480px] text-[17px] leading-[1.65] text-dusk">
          We reply within one business day — with questions, not a sales pitch. Prefer email? Write to{" "}
          <a href={`mailto:${site.email}`} class="border-b border-[#3d414c] text-white">{site.email}</a>.
        </p>

        <!-- 3D scene: message flow -->
        <div class="pointer-events-none mt-10 h-[250px] w-[min(400px,90vw)] [perspective:1100px]">
          <div
            class="relative h-full w-full transition-transform duration-[250ms] ease-out [transform-style:preserve-3d]"
            style="--bx:14deg;--by:-12deg;transform:rotateX(14deg) rotateY(-12deg)"
            data-scene
            data-base-x="14"
            data-base-y="-12"
            data-range-x="12"
            data-range-y="16"
          >
            <div
              class="absolute top-3 left-2 w-[240px] rounded-[14px] border border-edge-3 bg-night-card px-[18px] py-4 shadow-[0_24px_55px_rgba(0,0,0,0.55)]"
              style="transform:translateZ(-30px);animation:ms-float2 6.5s ease-in-out infinite"
            >
              <div class="font-mono text-[11px] text-dusk-3">you → {site.email}</div>
              <div class="mt-2.5 flex flex-col gap-[7px]">
                <span class="h-2 w-40 rounded-sm bg-[#3d414c]"></span>
                <span class="h-2 w-[120px] rounded-sm bg-edge-2"></span>
              </div>
            </div>
            <div
              class="absolute top-24 right-6 w-[240px] rounded-[14px] border border-edge-4 bg-night-card/95 px-[18px] py-4 shadow-[0_26px_55px_rgba(0,0,0,0.6)]"
              style="transform:translateZ(60px);animation:ms-float 6s ease-in-out infinite 0.5s"
            >
              <div class="flex items-center gap-2 font-mono text-[11px] text-steel">
                <span class="grid size-5 place-items-center rounded-full bg-white text-[9px] font-bold text-night">M</span>
                reply · within 1 business day
              </div>
              <div class="mt-2.5 flex flex-col gap-[7px]">
                <span class="h-2 w-[170px] rounded-sm bg-[#3d414c]"></span>
                <span class="h-2 w-[100px] rounded-sm bg-edge-2"></span>
              </div>
            </div>
            <div
              class="absolute bottom-1 left-10 flex items-center gap-[9px] rounded-full border border-edge-3 bg-night-card/90 px-4 py-[9px]"
              style="transform:translateZ(96px);animation:ms-float 5.4s ease-in-out infinite 1s"
            >
              <span class="size-2 rounded-full bg-white" style="animation:ms-pulse 1.6s ease-in-out infinite"></span>
              <span class="font-mono text-[11px] text-dusk-2">no sales theater, promise</span>
            </div>
          </div>
        </div>
      </div>

      <!-- form -->
      <div class="min-w-0 lg:min-w-[400px] lg:max-w-[520px] lg:flex-1">
        <!-- sent state -->
        <div id="sent-card" class="mt-6 hidden rounded-[18px] border border-edge-4 bg-night-card px-10 py-12 text-center">
          <span class="mx-auto grid size-[52px] place-items-center rounded-full bg-white">
            <svg viewBox="0 0 20 20" width="22" height="22">
              <path d="M4 10.5l4 4 8-9" stroke="#0e0f13" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
          <div class="mt-5 text-[22px] font-semibold">Message sent</div>
          <p class="mt-2.5 text-[14.5px] leading-relaxed text-dusk-2">
            Thanks — we'll get back to you within one business day.
          </p>
          <button id="send-another" class="btn-ghost-dark mt-6 cursor-pointer !px-[22px] !py-[11px] !text-sm">
            Send another
          </button>
        </div>

        <form
          id="contact-form"
          action={formEndpoint}
          method="POST"
          class="mt-6 flex flex-col gap-[18px] rounded-[18px] border border-edge-2 bg-night-card p-9"
        >
          <input type="hidden" name="form" value="contact" />
          <input type="hidden" name="_subject" value="New message from moldstep.com" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
              <label for="name" class="font-mono text-[11px] tracking-[0.12em] text-dusk-3 uppercase">Name</label>
              <input id="name" name="name" type="text" required placeholder="Jane Doe" class="input-dark" />
            </div>
            <div class="flex flex-col gap-2">
              <label for="email" class="font-mono text-[11px] tracking-[0.12em] text-dusk-3 uppercase">Email</label>
              <input id="email" name="email" type="email" required placeholder="jane@company.com" class="input-dark" />
            </div>
          </div>
          <div class="flex flex-col gap-2">
            <label for="message" class="font-mono text-[11px] tracking-[0.12em] text-dusk-3 uppercase">
              What are you building?
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              placeholder="A rough idea is enough — we'll ask the right questions."
              class="input-dark resize-y"></textarea>
          </div>
          <div class="flex flex-wrap gap-2">
            {
              topics.map((t) => (
                <button
                  type="button"
                  data-topic={t}
                  aria-pressed="false"
                  class="cursor-pointer rounded-full border border-edge-2 bg-transparent px-4 py-2 text-[12.5px] text-dusk-2 transition-colors hover:border-[#565c68] aria-pressed:bg-white aria-pressed:text-night"
                >
                  {t}
                </button>
              ))
            }
          </div>
          <button
            type="submit"
            class="cursor-pointer rounded-[10px] bg-white p-[15px] text-[15px] font-medium text-night transition-colors hover:bg-[#d7d9de] disabled:cursor-wait disabled:opacity-60"
          >
            Send message
          </button>
          <p id="form-error" class="hidden text-center text-[13px] text-[#e08d8d]">
            Something went wrong sending your message. Please try again, or email us directly at{" "}
            <a href={`mailto:${site.email}`} class="underline">{site.email}</a>.
          </p>
        </form>
      </div>
    </div>
  </section>

  <section class="bg-night">
    <div class="container-site">
      <Footer />
    </div>
  </section>

  <script>
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const sentCard = document.getElementById("sent-card");
    const sendAnother = document.getElementById("send-another");

    form?.querySelectorAll<HTMLButtonElement>("[data-topic]").forEach((chip) => {
      chip.addEventListener("click", () => {
        chip.setAttribute("aria-pressed", chip.getAttribute("aria-pressed") === "true" ? "false" : "true");
      });
    });

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const errorBox = document.getElementById("form-error");
      const submitButton = form.querySelector<HTMLButtonElement>("button[type='submit']");
      errorBox?.classList.add("hidden");
      if (submitButton) submitButton.disabled = true;

      const data = new FormData(form);
      const selected = [...form.querySelectorAll<HTMLButtonElement>("[data-topic][aria-pressed='true']")].map(
        (chip) => chip.dataset.topic
      );
      data.append("topics", selected.join(", "));

      try {
        const res = await fetch(form.action, { method: "POST", body: data, headers: { Accept: "application/json" } });
        // FormSubmit returns 200 even on failure (e.g. unactivated form) —
        // the JSON "success" field is the real delivery signal.
        const result = await res.json().catch(() => null);
        if (!res.ok || String(result?.success) !== "true") {
          throw new Error(result?.message || `Form service responded ${res.status}`);
        }
        form.classList.add("hidden");
        sentCard?.classList.remove("hidden");
      } catch (err) {
        console.error("Form submission failed", err);
        errorBox?.classList.remove("hidden");
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });

    sendAnother?.addEventListener("click", () => {
      form?.reset();
      form?.querySelectorAll("[data-topic]").forEach((chip) => chip.setAttribute("aria-pressed", "false"));
      sentCard?.classList.add("hidden");
      form?.classList.remove("hidden");
    });
  </script>
</BaseLayout>
