---
import BaseLayout from "@layouts/BaseLayout.astro";
import { site } from "@lib/site";
---

<BaseLayout
  title="Contact"
  description="Start a project with Moldstep LLC. Tell us about your goals and we'll reply within one business day."
>
  <section class="border-b border-line bg-surface">
    <div class="container-site py-20 md:py-28">
      <p class="eyebrow mb-5">Contact</p>
      <h1 class="max-w-3xl text-4xl font-semibold tracking-tight text-balance md:text-5xl">Let's talk about your project</h1>
      <p class="mt-6 max-w-2xl text-lg text-muted">
        Whether it's a rough idea or a detailed brief, we'll reply within one business day with honest next steps — and
        no pressure.
      </p>
    </div>
  </section>

  <section>
    <div class="container-site grid gap-16 py-20 md:grid-cols-[1fr_1.5fr] md:py-28">
      <div class="space-y-8">
        <div>
          <p class="eyebrow mb-2">Email</p>
          <a href={`mailto:${site.email}`} class="text-lg font-medium hover:underline">{site.email}</a>
        </div>
        <div>
          <p class="eyebrow mb-2">What happens next</p>
          <ol class="space-y-3">
            <li class="flex gap-3 text-sm text-muted">
              <span class="font-mono text-ink">1.</span> We review your message and reply within one business day.
            </li>
            <li class="flex gap-3 text-sm text-muted">
              <span class="font-mono text-ink">2.</span> A 30-minute call to understand goals and constraints.
            </li>
            <li class="flex gap-3 text-sm text-muted">
              <span class="font-mono text-ink">3.</span> You receive a clear proposal with scope, timeline, and budget.
            </li>
          </ol>
        </div>
      </div>

      {/* Form posts to Formspree — replace YOUR_FORM_ID after creating a free form at formspree.io */}
      <form
        action="https://formspree.io/f/YOUR_FORM_ID"
        method="POST"
        class="space-y-5 rounded-xl border border-line bg-white p-8"
      >
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="space-y-1.5">
            <label for="name" class="block text-sm font-medium">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              class="w-full rounded-lg border border-line px-4 py-2.5 text-sm outline-none transition-colors focus:border-ink"
              placeholder="Your name"
            />
          </div>
          <div class="space-y-1.5">
            <label for="email" class="block text-sm font-medium">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="w-full rounded-lg border border-line px-4 py-2.5 text-sm outline-none transition-colors focus:border-ink"
              placeholder="you@company.com"
            />
          </div>
        </div>
        <div class="space-y-1.5">
          <label for="company" class="block text-sm font-medium">Company <span class="text-muted">(optional)</span></label>
          <input
            id="company"
            name="company"
            type="text"
            class="w-full rounded-lg border border-line px-4 py-2.5 text-sm outline-none transition-colors focus:border-ink"
            placeholder="Company name"
          />
        </div>
        <div class="space-y-1.5">
          <label for="message" class="block text-sm font-medium">Project details</label>
          <textarea
            id="message"
            name="message"
            required
            rows="6"
            class="w-full resize-y rounded-lg border border-line px-4 py-2.5 text-sm outline-none transition-colors focus:border-ink"
            placeholder="What are you building, or what problem are you solving?"></textarea>
        </div>
        <button type="submit" class="btn-primary w-full">Send message</button>
        <p class="text-center text-xs text-muted">Prefer email? Write to us directly at {site.email}.</p>
      </form>
    </div>
  </section>
</BaseLayout>
