---
import BaseLayout from "@layouts/BaseLayout.astro";
import CtaSection from "@components/CtaSection.astro";
import { services } from "@lib/site";
---

<BaseLayout
  title="Services"
  description="Custom AI applications, AI integration, web and mobile development, IT strategy consulting, cloud, DevOps, and data engineering — delivered by Moldstep LLC."
>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-[#1b1e25]" data-parallax>
    <div class="hero-grid absolute inset-0"></div>
    <div class="container-site relative flex flex-wrap items-center gap-10 py-16 md:py-18">
      <div class="min-w-0 flex-1 md:min-w-[440px]">
        <div class="eyebrow flex items-center gap-2.5 text-dusk-3">
          <span class="h-px w-6 bg-[#3d414c]"></span>Services
        </div>
        <h1 class="mt-6 text-[clamp(38px,4.4vw,56px)] leading-[1.05] font-semibold tracking-[-0.03em]">
          Six ways we move your product forward.
        </h1>
        <p class="mt-6 max-w-[520px] text-[17px] leading-[1.65] text-dusk">
          Every engagement is delivered by senior engineers, scoped honestly, and built on proven stacks. AI where it
          pays off — solid software everywhere else.
        </p>
      </div>

      <!-- 3D scene: module stack -->
      <div class="pointer-events-none mx-auto h-[340px] w-[min(420px,90vw)] flex-none [perspective:1200px]">
        <div
          class="relative h-full w-full transition-transform duration-[250ms] ease-out [transform-style:preserve-3d]"
          style="transform:rotateX(14deg) rotateY(-14deg)"
          data-scene
          data-base-x="14"
          data-base-y="-14"
          data-range-x="14"
          data-range-y="18"
        >
          <div
            class="absolute top-[18px] left-10 flex h-[74px] w-[280px] items-center gap-3.5 rounded-[14px] border border-edge-2 bg-night-card/90 px-5 shadow-[0_24px_50px_rgba(0,0,0,0.5)]"
            style="transform:translateZ(-70px);animation:ms-float 7s ease-in-out infinite"
          >
            <span class="grid size-[34px] flex-none place-items-center rounded-[9px] bg-edge-2 font-mono text-xs text-dusk-2">AI</span>
            <div>
              <div class="text-[13px] font-semibold">AI applications</div>
              <div class="font-mono text-[11px] text-dusk-3">LLM · RAG · copilots</div>
            </div>
          </div>
          <div
            class="absolute top-[118px] left-3 flex h-[74px] w-[280px] items-center gap-3.5 rounded-[14px] border border-edge-3 bg-night-card px-5 shadow-[0_26px_60px_rgba(0,0,0,0.55)]"
            style="transform:translateZ(10px);animation:ms-float2 6s ease-in-out infinite 0.4s"
          >
            <span class="grid size-[34px] flex-none place-items-center rounded-[9px] bg-edge-2 font-mono text-xs text-dusk-2">{`{ }`}</span>
            <div>
              <div class="text-[13px] font-semibold">Software engineering</div>
              <div class="font-mono text-[11px] text-dusk-3">web · mobile · SaaS</div>
            </div>
          </div>
          <div
            class="absolute top-[218px] left-16 flex h-[74px] w-[280px] items-center gap-3.5 rounded-[14px] border border-edge-4 bg-night-card/95 px-5 shadow-[0_26px_55px_rgba(0,0,0,0.6)]"
            style="transform:translateZ(90px);animation:ms-float 5.5s ease-in-out infinite 0.9s"
          >
            <span class="grid size-[34px] flex-none place-items-center rounded-full bg-white">
              <svg viewBox="0 0 20 20" width="16" height="16">
                <path d="M4 10.5l4 4 8-9" stroke="#0e0f13" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
            <div>
              <div class="text-[13px] font-semibold">Strategy &amp; delivery</div>
              <div class="font-mono text-[11px] text-dusk-3">consulting · cloud · data</div>
            </div>
          </div>
          <svg viewBox="0 0 60 220" width="60" height="220" class="absolute top-[50px] right-4" style="transform:translateZ(-30px)">
            <path d="M30 0 v220" stroke="#272a33" stroke-width="2" stroke-dasharray="4 8" style="animation:ms-dash 3s linear infinite"></path>
            <circle cx="30" cy="40" r="6" fill="#3d414c"></circle>
            <circle cx="30" cy="120" r="6" fill="#3d414c"></circle>
            <circle cx="30" cy="200" r="8" fill="#ffffff"></circle>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES DETAIL -->
  <section class="bg-surface text-ink">
    <div class="container-site py-20">
      <div class="grid gap-5 [perspective:1100px] md:grid-cols-2">
        {
          services.map((s) => (
            <div
              class="flex flex-col gap-3 rounded-2xl border border-line-2 bg-white p-8 hover:border-[#b9b9c0] hover:shadow-[0_20px_40px_rgba(24,24,27,0.1)]"
              style="transition:border-color 0.2s,box-shadow 0.2s,transform 0.15s ease-out"
              data-tilt="8"
              data-lift="-4"
            >
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs text-ghost">{s.num}</span>
                <span class="rounded-full border border-line-2 px-3 py-[5px] font-mono text-[11px] tracking-[0.14em] text-faint uppercase">
                  {s.tag}
                </span>
              </div>
              <div class="text-xl font-semibold tracking-[-0.01em]">{s.title}</div>
              <p class="text-[14.5px] leading-[1.65] text-slate">{s.description}</p>
              <div class="mt-2 flex flex-col gap-2.5 border-t border-line pt-4">
                {s.points.map((pt) => (
                  <div class="flex items-center gap-2.5 text-[13.5px] text-ink-soft">
                    <span class="size-[5px] flex-none rounded-full bg-[#b9b9c0]" aria-hidden="true" />
                    {pt}
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaSection
    title="Not sure which service fits?"
    text="Describe the problem — we'll tell you the simplest way to solve it, even if it's not us."
  />
</BaseLayout>
